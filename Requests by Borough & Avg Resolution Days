WITH combined_data AS (
    SELECT created_date, requesttype FROM nyc_311_2016
    UNION ALL
    SELECT created_date, requesttype FROM nyc_311_2017
    UNION ALL
    SELECT created_date, requesttype FROM nyc_311_2018
UNION ALL
    SELECT created_date, requesttype FROM nyc_311_2019
    UNION ALL
    SELECT created_date, requesttype FROM nyc_311_2020
)
SELECT 
    EXTRACT(YEAR FROM created_date) AS year, requesttype,
    COUNT(requesttype) AS total
FROM 
    combined_data
GROUP BY 
    EXTRACT(YEAR FROM created_date),  requesttype
ORDER BY 
    year;
