SELECT
    COUNT(*) AS order_lines,
    SUM(CASE WHEN r.region_id IS NULL THEN 1 ELSE 0 END) AS missing_region_lines,
    SUM(CASE WHEN c.customer_id IS NULL THEN 1 ELSE 0 END) AS missing_customer_lines,
    SUM(CASE WHEN p.product_id IS NULL THEN 1 ELSE 0 END) AS missing_product_lines,
    100.0 * SUM(CASE WHEN r.region_id IS NOT NULL THEN 1 ELSE 0 END)
        / NULLIF(COUNT(*), 0) AS region_match_pct,
    100.0 * SUM(CASE WHEN c.customer_id IS NOT NULL THEN 1 ELSE 0 END)
        / NULLIF(COUNT(*), 0) AS customer_match_pct,
    100.0 * SUM(CASE WHEN p.product_id IS NOT NULL THEN 1 ELSE 0 END)
        / NULLIF(COUNT(*), 0) AS product_match_pct
FROM Orders AS o
LEFT JOIN Regions AS r
    ON o.region_id = r.region_id
LEFT JOIN Customers AS c
    ON o.customer_id = c.customer_id
LEFT JOIN Products AS p
    ON o.product_id = p.product_id;
