SELECT
    o.order_id,
    o.order_date,
    o.ship_date,
    o.ship_mode,
    r.region,
    r.sub_region,
    r.salesperson,
    c.customer_id,
    c.customer_name,
    c.segment,
    p.product_id,
    p.product_name,
    p.category,
    p.sub_category,
    o.sales,
    o.quantity,
    o.discount,
    o.profit,
    o.profit / NULLIF(o.sales, 0) AS line_profit_margin,
    o.postal_code
FROM Orders AS o
LEFT JOIN Regions AS r
    ON o.region_id = r.region_id
LEFT JOIN Customers AS c
    ON o.customer_id = c.customer_id
LEFT JOIN Products AS p
    ON o.product_id = p.product_id
WHERE o.profit < 0
ORDER BY o.profit ASC, o.sales DESC;
